{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nebula Terminal",
  "version": "1.2.0-beta.1",
  "identifier": "dev.awizz.nebula-terminal",
  "build": {
    "beforeDevCommand": "node scripts/build-sidecar.mjs && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/build-sidecar.mjs --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nebula Terminal",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 460,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "A good-looking terminal for Windows with Linux commands built in",
    "longDescription": "Nebula Terminal runs Nebula, a Linux-style command interpreter, alongside PowerShell, Command Prompt, Git Bash and WSL, with tabs, split panes and live visual customization.",
    "externalBin": [
      "binaries/nebula-sh"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "windows/launchers.wxs"
        ],
        "componentRefs": [
          "LauncherCleanup"
        ],
        "version": "1.2.0"
      }
    }
  }
}
