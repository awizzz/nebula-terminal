<?xml version="1.0" encoding="utf-8"?>
<!-- The app adds "Open in Nebula Terminal" to File Explorer and the nebula-terminal
     command to the user's PATH itself (launcher.rs). This only removes them when the
     app is uninstalled, not when an update replaces it. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="LauncherCleanup" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\Nebula Terminal" Name="Launcher Cleanup" Type="integer" Value="1" KeyPath="yes" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\NebulaTerminal" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\NebulaTerminal" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Drive\shell\NebulaTerminal" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Nebula Terminal" Action="removeOnUninstall" />
      </Component>
    </DirectoryRef>

    <!-- Runs the app with --uninstall while its files are still there. -->
    <CustomAction Id="LauncherUninstall" FileKey="Path" ExeCommand="--uninstall" Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="LauncherUninstall" Before="RemoveFiles">REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
